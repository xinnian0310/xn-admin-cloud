# 本地开发可复制为 .env 或导出到环境变量；本文件不含真实生产密钥
# 用法示例（PowerShell）:
#   $env:SPRING_PROFILES_ACTIVE="prod"
#   $env:JWT_SECRET="至少32字符的随机串"
#   $env:DB_USERNAME="smartadmin"
#   $env:DB_PASSWORD="******"
#   $env:CORS_ALLOWED_ORIGINS="https://admin.example.com"
#   $env:MINIO_ACCESS_KEY="..."
#   $env:MINIO_SECRET_KEY="..."

SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=XnAdminSecretKeyForJwtTokenGeneration2026MustBeLongEnough
DB_USERNAME=root
DB_PASSWORD=root
DB_URL=jdbc:mysql://127.0.0.1:3306/smartadmin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
CORS_ALLOWED_ORIGINS=*
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SWAGGER_ENABLED=true
INFRA_RESTART_ENABLED=true
