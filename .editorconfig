root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,xml,yml,yaml,properties,md,json}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.{cmd,bat,ps1}]
end_of_line = crlf

[mvnw.cmd]
end_of_line = crlf

[*.sql]
indent_size = 2
